{
  "id": "template-component-library",
  "name": "Component Library",
  "category": "component",
  "template": {
    "name": "Component Library",
    "description": "Reusable component library with pink styling",
    "data": {
      "label": "Component Library"
    },
    "jinjaTemplate": "<div style=\"\n  text-align: center;\n  padding: 12px;\n  width: {{ width or 150 }}px;\n  border-radius: {{ borderRadius or 12 }}px;\n  background: {{ backgroundColor or '#fce7f3' }};\n  border: {{ borderWidth or 2 }}px solid {{ borderColor or '#ec4899' }};\n\">\n  <div style=\"font-size: {{ iconSize or 28 }}px; margin-bottom: 8px;\">\n    {{ icon or '📚' }}\n  </div>\n  <div style=\"\n    font-weight: 600;\n    font-size: {{ labelSize or 14 }}px;\n    color: {{ labelColor or '#be185d' }};\n  \">\n    {{ label }}\n  </div>\n  {% if subtitle %}\n  <div style=\"\n    font-size: {{ subtitleSize or 11 }}px;\n    color: {{ subtitleColor or '#64748b' }};\n    margin-top: 4px;\n  \">\n    {{ subtitle }}\n  </div>\n  {% endif %}\n</div>",
    "variables": [
      {
        "name": "label",
        "label": "Label",
        "type": "text",
        "required": true
      },
      {
        "name": "subtitle",
        "label": "Subtitle",
        "type": "text"
      },
      {
        "name": "icon",
        "label": "Icon",
        "type": "icon"
      },
      {
        "name": "width",
        "label": "Width",
        "type": "number",
        "min": 120,
        "max": 250
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color"
      },
      {
        "name": "borderColor",
        "label": "Border Color",
        "type": "color"
      },
      {
        "name": "borderWidth",
        "label": "Border Width",
        "type": "number",
        "min": 1,
        "max": 5
      },
      {
        "name": "borderRadius",
        "label": "Border Radius",
        "type": "number",
        "min": 0,
        "max": 20
      },
      {
        "name": "labelColor",
        "label": "Label Color",
        "type": "color"
      },
      {
        "name": "labelSize",
        "label": "Label Size",
        "type": "number",
        "min": 10,
        "max": 24
      },
      {
        "name": "subtitleColor",
        "label": "Subtitle Color",
        "type": "color"
      },
      {
        "name": "subtitleSize",
        "label": "Subtitle Size",
        "type": "number",
        "min": 8,
        "max": 18
      },
      {
        "name": "iconSize",
        "label": "Icon Size",
        "type": "number",
        "min": 20,
        "max": 64
      }
    ],
    "style": {},
    "isPublic": true,
    "tags": [
      "component",
      "library",
      "ui"
    ]
  }
}
