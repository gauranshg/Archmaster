{
  "id": "template-container-mobile",
  "name": "Mobile App",
  "category": "container",
  "template": {
    "name": "Mobile App",
    "description": "Phone frame design",
    "data": {
      "label": "Mobile App"
    },
    "jinjaTemplate": "<div style=\"\n  position: relative;\n  width: {{ width or 110 }}px;\n  height: {{ height or 180 }}px;\n  background: {{ backgroundColor or '#1e293b' }};\n  border-radius: 24px;\n  padding: 8px;\n  box-shadow: 0 8px 24px rgba(0,0,0,0.3);\n\">\n  <!-- Phone screen -->\n  <div style=\"\n    width: 100%;\n    height: 100%;\n    background: {{ screenBg or '#0ea5e9' }};\n    border-radius: 18px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 12px;\n    text-align: center;\n  \">\n    <!-- Notch/camera -->\n    <div style=\"\n      position: absolute;\n      top: 12px;\n      width: 40px;\n      height: 4px;\n      background: {{ notchColor or '#0f172a' }};\n      border-radius: 2px;\n    \"></div>\n\n    <!-- Icon -->\n    <div style=\"\n      font-size: {{ iconSize or 32 }}px;\n      margin-bottom: 8px;\n      margin-top: 8px;\n    \">{{ icon or '📱' }}</div>\n\n    <!-- Label -->\n    <div style=\"\n      font-weight: 700;\n      font-size: {{ labelSize or 13 }}px;\n      color: {{ labelColor or '#ffffff' }};\n      margin-bottom: 4px;\n      line-height: 1.3;\n    \">{{ label }}</div>\n\n    {% if subtitle %}\n    <div style=\"\n      font-size: {{ subtitleSize or 9 }}px;\n      color: {{ subtitleColor or '#bae6fd' }};\n      font-weight: 500;\n    \">{{ subtitle }}</div>\n    {% endif %}\n\n    <!-- Home indicator -->\n    <div style=\"\n      position: absolute;\n      bottom: 8px;\n      width: 30px;\n      height: 3px;\n      background: {{ homeIndicator or '#ffffff' }};\n      border-radius: 2px;\n      opacity: 0.8;\n    \"></div>\n  </div>\n</div>",
    "variables": [
      {
        "name": "label",
        "label": "Label",
        "type": "text",
        "required": true
      },
      {
        "name": "subtitle",
        "label": "Subtitle",
        "type": "text"
      },
      {
        "name": "icon",
        "label": "Icon",
        "type": "icon"
      },
      {
        "name": "width",
        "label": "Width",
        "type": "number",
        "min": 120,
        "max": 250
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color"
      },
      {
        "name": "borderColor",
        "label": "Border Color",
        "type": "color"
      },
      {
        "name": "borderWidth",
        "label": "Border Width",
        "type": "number",
        "min": 1,
        "max": 5
      },
      {
        "name": "borderRadius",
        "label": "Border Radius",
        "type": "number",
        "min": 0,
        "max": 25
      },
      {
        "name": "labelColor",
        "label": "Label Color",
        "type": "color"
      },
      {
        "name": "labelSize",
        "label": "Label Size",
        "type": "number",
        "min": 10,
        "max": 24
      },
      {
        "name": "subtitleColor",
        "label": "Subtitle Color",
        "type": "color"
      },
      {
        "name": "subtitleSize",
        "label": "Subtitle Size",
        "type": "number",
        "min": 8,
        "max": 18
      },
      {
        "name": "iconSize",
        "label": "Icon Size",
        "type": "number",
        "min": 20,
        "max": 64
      }
    ],
    "style": {},
    "isPublic": true,
    "tags": [
      "container",
      "mobile",
      "app"
    ]
  }
}
